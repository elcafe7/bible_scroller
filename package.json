{
  "name": "bible_scroller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ambient offline Geneva 1599 verse scroller with optional Matthew Henry interchange.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build-data": "node --no-warnings scripts/build-data.mjs",
    "test": "vitest run",
    "pack": "npm run build && node scripts/pack-zip.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
